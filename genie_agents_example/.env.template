# Copy to a local, gitignored .env, or use myprojects/_local/.env.
# Do not commit real hosts, IDs, client IDs, secrets, or tokens.

DATABRICKS_HOST=https://your-workspace-host
APP_AUTH_TYPE=oauth_u2m
DATABRICKS_U2M_CLIENT_ID=<oauth-app-client-id>
DATABRICKS_U2M_CLIENT_SECRET=<oauth-app-client-secret>
DATABRICKS_REDIRECT_URI=http://localhost:8020/callback
DATABRICKS_OAUTH_SCOPE=genie

# The same Genie Agent identifier is used by both /spaces/{id} and /agents/{id}.
GENIE_AGENT_ID=<genie-agent-id>

# Optional shared question
# GENIE_QUESTION=get the total revenue for my bakehouse

# Optional Example 01 SSE settings (visualization is always disabled)
# GENIE_AGENT_TIMEOUT_SEC=1800
# GENIE_AGENT_TIMEZONE=America/Los_Angeles

# Example 02 collects its connection values in the browser UI and always
# enables visualization; it does not load them from this file.

# Optional Example 03 polling settings
# GENIE_CONVERSATION_POLL_INTERVAL_SEC=3
# GENIE_CONVERSATION_MAX_POLL_ATTEMPTS=200
# GENIE_CONVERSATION_HTTP_TIMEOUT_SEC=120
