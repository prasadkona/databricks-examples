# Copy values into a real .env (gitignored). The example prefers
# myprojects/_local/.env, which already has DATABRICKS_HOST and U2M credentials.
#
# Required:
#   DATABRICKS_HOST
#   APP_AUTH_TYPE=oauth_u2m
#   DATABRICKS_U2M_CLIENT_ID
#   DATABRICKS_U2M_CLIENT_SECRET   (confidential OAuth apps)
#   DATABRICKS_REDIRECT_URI        (must match App connections)
#
# Unity Gateway Genie One MCP uses OAuth scope ai-gateway (not the deprecated
# genie scope used by POST /api/2.0/mcp/genie). all-apis also works if the
# OAuth app allows it.

DATABRICKS_HOST=https://your-workspace-host
APP_AUTH_TYPE=oauth_u2m
DATABRICKS_U2M_CLIENT_ID=<oauth-app-client-id>
DATABRICKS_U2M_CLIENT_SECRET=<oauth-app-client-secret>
DATABRICKS_REDIRECT_URI=http://localhost:8020/callback
DATABRICKS_OAUTH_SCOPE=ai-gateway

# Optional
# DATABRICKS_WAREHOUSE_ID=
# GENIE_MCP_QUESTION=get the total revenue for my bakehouse
# GENIE_MCP_POLL_INTERVAL_SEC=3
# GENIE_MCP_MAX_POLL_ATTEMPTS=60
